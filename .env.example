# SENTINEL Environment Template
# Copy to .env and fill in your own local development / hackathon sandbox credentials.
# Never commit .env to Git!

# --- Google Gemini AI Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# --- PayPal Developer Sandbox Configuration (https://developer.paypal.com/dashboard) ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_DEFAULT_RECEIVER=sb-buyer@personal.example.com

# --- SENTINEL Edge Gateway & Secrets ---
SENTINEL_GATEWAY_URL=http://localhost:8080/enforce
SENTINEL_AGENT_SECRET=sentinel-agent-auth-secret-2026
SENTINEL_INTENT_SECRET=sentinel-intent-mandate-secret-2026
SENTINEL_STRICT_AUTH=false
SENTINEL_REQUIRE_INTENT_MANDATE=false

# --- Infrastructure Defaults (docker-compose.yml) ---
SENTINEL_DB_HOST=localhost
SENTINEL_DB_PORT=5432
SENTINEL_DB_NAME=sentinel_audit
SENTINEL_DB_USER=sentinel
SENTINEL_DB_PASS=password123
SENTINEL_REDIS_HOST=localhost
SENTINEL_REDIS_PORT=6379

